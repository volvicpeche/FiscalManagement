// Persistence of saved scenarios, in the Postgres of the Supabase project.
//
// That project is shared with other applications: every table here lives in
// the dedicated `tax` schema, never in `public`. The schema is not named in
// this file: prisma.config.ts puts it on the migration URL, and the adapter
// option in src/services/db.ts on the queries (DB_SCHEMA).
//
// Users live in Supabase's own `auth.users` table: the server never stores a
// password. `user_id` is the `sub` of the Supabase JWT, and the foreign key to
// `auth.users` is added by hand in the migration (Prisma cannot model a table
// of another schema it does not own).
//
// The connection URL is not here: Prisma 7 reads it from prisma.config.ts.

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  // The server runs as native Node ESM (tsc, no bundler): relative imports
  // need their extension.
  moduleFormat        = "esm"
  importFileExtension = "js"
}

// ─── Scenarios ───────────────────────────────────────────────────────────────

/// A saved scenario. `data` is the client store's own shape, deliberately
/// opaque to the server (see shared/scenario.ts); `version` says which format
/// it was written under.
model Scenario {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  nom       String   @db.VarChar(120)
  /// 'sci' | 'saisonnier' | 'frontalier', validated by ScenarioKind (Zod).
  kind      String
  version   Int
  data      Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId, updatedAt(sort: Desc)])
  @@map("scenarios")
}

// ─── LLM quota ───────────────────────────────────────────────────────────────

/// Paid LLM calls per user and per day (UTC). Sign-up is open, so without it
/// any account could spend the server's API key.
model LlmUsage {
  userId String   @map("user_id") @db.Uuid
  jour   DateTime @db.Date
  appels Int      @default(0)

  @@id([userId, jour])
  @@map("llm_usage")
}

// ─── Per-user LLM key ────────────────────────────────────────────────────────

/// A user's own LLM provider and API key. The key is encrypted with
/// LLM_KEYS_SECRET (AES-256-GCM, bound to the user id — services/secretBox.ts)
/// and never sent back to the client: only its last four characters are.
model LlmSettings {
  userId      String   @id @map("user_id") @db.Uuid
  /// 'anthropic' | 'openai' | 'gemini' | 'openai_compatible', validated by Zod.
  provider    String
  model       String?  @db.VarChar(100)
  baseUrl     String?  @map("base_url") @db.VarChar(300)
  cleChiffree String   @map("cle_chiffree")
  cleFin      String   @map("cle_fin") @db.VarChar(4)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("llm_settings")
}
