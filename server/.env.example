DATABASE_URL="postgresql://user:password@localhost:5432/patrimonia?schema=public"

# ─── LLM : analyse d'annonce et lecture de justificatifs ────────────────────
#
# Two buttons call an LLM, and nothing else in the app does:
# - "Analyser" in the "Location saisonniere" tab (POST /api/listings/analyze):
#   extraction of a real-estate listing + a rough seasonal-rental estimate.
#   Works with any provider below.
# - The document drop zone of the "Frontalier Geneve" tab
#   (POST /api/frontalier/documents): reads salary certificates, 3a
#   statements, insurance, interest... The PDF or photo itself is sent to the
#   model, which only the anthropic provider supports.
# Without this section configured, those buttons return an error but the rest
# of the app (comparators, manual inputs, TOU simulation) works normally.
#
# After editing this file, restart `npm run dev` — server/src/index.ts loads
# .env once at startup via `dotenv/config`, not on every save.
#
# 1. Pick ONE provider below with LLM_PROVIDER, then fill in only that
#    provider's key/model — the others are ignored.
# 2. Copy this file to server/.env (untracked by git).

LLM_PROVIDER="anthropic"   # anthropic | openai | gemini | openai_compatible

# anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"

# openai (ChatGPT) — https://platform.openai.com/api-keys
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"

# openai_compatible — any provider that speaks the OpenAI chat-completions
# wire format: Qwen/DashScope, DeepSeek, Groq, Mistral, a local Ollama/vLLM
# server, etc. Example for Qwen via Alibaba DashScope:
#   OPENAI_COMPATIBLE_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
#   OPENAI_COMPATIBLE_MODEL="qwen-plus"
OPENAI_COMPATIBLE_API_KEY=""
OPENAI_COMPATIBLE_BASE_URL=""
OPENAI_COMPATIBLE_MODEL=""

# All of these are paid APIs, separate from any Claude.ai / ChatGPT Plus /
# Gemini subscription — each requires its own billing/credits set up on the
# provider's console.

# ─── Lecture des annonces protegees ─────────────────────────────────────────
#
# SeLoger, LeBonCoin et PAP sont derriere DataDome et refusent (403) toute
# requete HTTP simple. Le serveur retombe alors sur un vrai Chrome pilote par
# patchright, qui est la seule methode qui passe. Contraintes mesurees :
# le mode headless est detecte, la fenetre doit donc s'ouvrir reellement
# (elle est positionnee hors ecran), et chaque annonce prend ~10 s.
#
# Mettre a "false" pour desactiver et n'utiliser que le collage de texte.
LISTING_BROWSER_FALLBACK=true
