# ─── Supabase : comptes utilisateurs et base de donnees ─────────────────────
#
# Trois valeurs a copier depuis votre projet Supabase : DEPLOY.md, etape 2 bis,
# les explique une par une (A1, A2, A3). Sans SUPABASE_URL, le serveur refuse
# de demarrer. Au demarrage, il verifie le reste tout seul et ecrit un bilan :
#   docker compose logs server | grep Supabase     (ou la console de npm run dev)

# A1 — Project Settings → Data API → Project URL
SUPABASE_URL="https://<ref>.supabase.co"
# A2 — Project Settings → API Keys → cle « anon » ou « publishable ». Publique
# par nature : elle est envoyee au navigateur par GET /api/config.
SUPABASE_ANON_KEY=""

# Laissez vide, sauf si le bilan de demarrage le demande (projet ancien qui
# signe ses jetons avec l'ancien secret) : Project Settings → JWT Keys →
# « Legacy JWT Secret ».
SUPABASE_JWT_SECRET=""

# A3 — bouton Connect → Session pooler, [YOUR-PASSWORD] remplace par le mot de
# passe de la base. (port 5432). PAS la connexion directe (IPv6
# seulement) ni le transaction pooler (port 6543, incompatible avec Prisma).
# Les migrations sont appliquees au demarrage du conteneur, dans le schema
# dedie `tax` (cree s'il manque) : rien n'est ecrit dans `public`, que le
# projet peut partager avec d'autres applications.
# En local, un Postgres simple convient : appliquez d'abord
# prisma/test/supabase-auth-stub.sql, puis `npm run db:deploy`.
DATABASE_URL="postgresql://postgres.<ref>:<mot-de-passe>@aws-0-eu-west-3.pooler.supabase.com:5432/postgres"

# Mettez false pour ne pas verifier Supabase au demarrage (tests, CI).
# SUPABASE_DIAGNOSTIC=false

# Scenarios enregistres par utilisateur, au plus.
MAX_SCENARIOS=200
# Appels payants au LLM par utilisateur et par jour (UTC), sur la cle du
# SERVEUR seulement (comptes de LLM_SERVER_KEY_EMAILS). Un utilisateur avec sa
# propre cle n'a pas de quota : c'est lui qui paie.
LLM_QUOTA_JOUR=20

# ─── LLM : analyse d'annonce et lecture de justificatifs ────────────────────
#
# Two buttons call an LLM, and nothing else in the app does:
# - "Analyser" in the "Location saisonniere" tab (POST /api/listings/analyze):
#   extraction of a real-estate listing + a rough seasonal-rental estimate.
#   Works with any provider below.
# - The document drop zone of the "Frontalier Geneve" tab
#   (POST /api/frontalier/documents): reads salary certificates, 3a
#   statements, insurance, interest... The PDF or photo itself is sent to the
#   model, which only the anthropic provider supports.
# Rest of the app (comparators, manual inputs, TOU simulation) needs no LLM.
#
# EACH USER BRINGS THEIR OWN KEY: they enter it in the app (« Cle LLM » button,
# top right). It is stored encrypted in the database with LLM_KEYS_SECRET and
# never sent back to the browser. A user without a key cannot use those two
# buttons — unless their e-mail is in LLM_SERVER_KEY_EMAILS, in which case the
# server's key below serves them (with the LLM_QUOTA_JOUR daily quota).
#
# After editing this file, restart `npm run dev` — server/src/index.ts loads
# .env once at startup via `dotenv/config`, not on every save.

# Encryption key of the users' API keys: 32 random bytes, base64.
#   openssl rand -base64 32
# Keep it (and back it up): if it is lost or changed, every stored key becomes
# unreadable and users must enter theirs again. Without it, users cannot save
# a key at all.
LLM_KEYS_SECRET=""

# Accounts (Supabase e-mails, comma-separated) allowed to use the server's key
# below when they have no key of their own. Empty: nobody.
LLM_SERVER_KEY_EMAILS=""

# ─── The server's own key (for LLM_SERVER_KEY_EMAILS only) ─────────────────
# 1. Pick ONE provider below with LLM_PROVIDER, then fill in only that
#    provider's key/model — the others are ignored.
# 2. Copy this file to server/.env (untracked by git).

LLM_PROVIDER="anthropic"   # anthropic | openai | gemini | openai_compatible

# anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"

# openai (ChatGPT) — https://platform.openai.com/api-keys
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"

# openai_compatible — any provider that speaks the OpenAI chat-completions
# wire format: Qwen/DashScope, DeepSeek, Groq, Mistral, a local Ollama/vLLM
# server, etc. Example for Qwen via Alibaba DashScope:
#   OPENAI_COMPATIBLE_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
#   OPENAI_COMPATIBLE_MODEL="qwen-plus"
OPENAI_COMPATIBLE_API_KEY=""
OPENAI_COMPATIBLE_BASE_URL=""
OPENAI_COMPATIBLE_MODEL=""

# All of these are paid APIs, separate from any Claude.ai / ChatGPT Plus /
# Gemini subscription — each requires its own billing/credits set up on the
# provider's console.

# ─── Lecture des annonces protegees ─────────────────────────────────────────
#
# SeLoger, LeBonCoin et PAP sont derriere DataDome et refusent (403) toute
# requete HTTP simple. Le serveur retombe alors sur un vrai Chrome pilote par
# patchright, qui est la seule methode qui passe. Contraintes mesurees :
# le mode headless est detecte, la fenetre doit donc s'ouvrir reellement
# (elle est positionnee hors ecran), et chaque annonce prend ~10 s.
#
# Mettre a "false" pour desactiver et n'utiliser que le collage de texte.
LISTING_BROWSER_FALLBACK=true
