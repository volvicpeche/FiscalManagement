DATABASE_URL="postgresql://user:password@localhost:5432/patrimonia?schema=public"

# Powers POST /api/listings/analyze (extraction of a real-estate listing from
# a URL + a rough seasonal-rental estimate), used by the "Location saisonniere"
# tab's "Analyser" button. Without this set, that one button returns an error
# but the rest of the app (SCI/Holding comparator, manual seasonal inputs)
# works normally — nothing else in the app calls the Anthropic API.
#
# 1. Create a key at https://console.anthropic.com/settings/keys
#    (requires an Anthropic Console account with billing set up — this is a
#    paid API, separate from any Claude.ai subscription).
# 2. Copy this file to server/.env (untracked by git) and paste the key below.
# 3. Restart `npm run dev` (server/src/index.ts loads .env on startup via
#    `dotenv/config` — changing the file requires a restart, not just a save).
ANTHROPIC_API_KEY=""
