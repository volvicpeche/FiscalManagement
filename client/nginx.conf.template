# Modèle rendu au démarrage par l'image nginx officielle (envsubst) : seules
# les variables ${SUPABASE_URL} et ${NGINX_LOCAL_RESOLVERS} sont remplacées
# (NGINX_ENVSUBST_FILTER, voir client/Dockerfile) ; toutes les autres $variables
# sont celles de nginx.

# ─── Limites de débit, par adresse IP ───────────────────────────────────────
# Derrière Caddy (HTTPS), toutes les requêtes arrivent de la même adresse : les
# limites deviennent globales plutôt que par visiteur. Les quotas qui comptent
# vraiment (analyses LLM, scénarios) sont tenus par le serveur, par compte.

# Tout le site : large, pour ne jamais gêner un usage normal.
limit_req_zone $binary_remote_addr zone=global:10m rate=20r/s;

# Analyse d'annonce : chaque appel peut lancer Chrome et consommer la clé LLM.
limit_req_zone $binary_remote_addr zone=annonce:10m rate=5r/m;

# Lecture de justificatifs (onglet Frontalier) : chaque fichier est un appel
# payant au modèle, et un envoi peut en compter dix.
limit_req_zone $binary_remote_addr zone=documents:10m rate=6r/m;

# Écritures de scénarios uniquement (POST/PUT/DELETE) : une clé vide exclut
# les lectures de la limite.
map $request_method $cle_ecriture {
    GET     "";
    HEAD    "";
    default $binary_remote_addr;
}
limit_req_zone $cle_ecriture zone=ecriture:10m rate=30r/m;

# Connexion, inscription, mot de passe oublié : freine qui essaierait de
# deviner un mot de passe. Supabase a ses propres limites en plus.
limit_req_zone $binary_remote_addr zone=auth:10m rate=30r/m;

limit_req_status 429;

server {
    listen 80;
    server_name _;

    # Ne pas annoncer la version de nginx.
    server_tokens off;

    # Rien dans l'application n'envoie plus que quelques dizaines de Ko.
    client_max_body_size 1m;

    root /usr/share/nginx/html;
    index index.html;

    # Pas de mot de passe ici : chaque route /api vérifie elle-même le jeton
    # Supabase (server/src/plugins/auth.ts). La page et ses fichiers statiques
    # sont publics, ils ne contiennent aucune donnée.

    limit_req zone=global burst=40 nodelay;

    # Hérité par chaque location /api ; l'analyse d'annonce le surcharge.
    proxy_read_timeout 60s;

    # En-têtes de sécurité (CSP, anti-iframe…) : voir security-headers.inc,
    # inclus aussi dans chaque location — nginx n'hérite pas des add_header du
    # niveau supérieur dès qu'une location déclare les siens.
    include /etc/nginx/conf.d/security-headers.inc;

    # Sonde de disponibilité : elle ne révèle rien.
    location = /api/health {
        proxy_pass http://server:3000;
    }

    # ─── Relais vers Supabase (authentification seulement) ──────────────────
    # Le navigateur ne parle qu'à ce domaine : un proxy d'entreprise qui
    # bloquerait supabase.co ne bloque pas la connexion, et la CSP reste
    # connect-src 'self'. Seule l'API d'authentification est relayée.
    #
    # L'adresse passe par une variable pour que nginx la résolve à chaque
    # expiration du DNS (valid=60s) et pas une seule fois au démarrage :
    # Supabase est derrière un CDN dont les IP changent.
    location /supabase/auth/v1/ {
        limit_req zone=auth burst=20 nodelay;
        limit_req zone=global burst=40 nodelay;

        resolver ${NGINX_LOCAL_RESOLVERS} valid=60s ipv6=off;
        set $supabase ${SUPABASE_URL};
        rewrite ^/supabase(/auth/v1/.*)$ $1 break;
        proxy_pass $supabase;

        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        # Host par défaut = celui de proxy_pass, ce qu'attend Supabase. Ne
        # rien transmettre de l'adresse du visiteur : Supabase ne ferait pas
        # confiance à un X-Forwarded-For venu d'ailleurs que de son CDN.
        proxy_set_header Cookie "";
        proxy_read_timeout 30s;

        include /etc/nginx/conf.d/security-headers.inc;
    }

    location = /api/listings/analyze {
        limit_req zone=annonce burst=3 nodelay;
        limit_req zone=global burst=40 nodelay;
        # Le navigateur peut prendre jusqu'à ~60 s sur une annonce protégée.
        proxy_read_timeout 90s;
        include /etc/nginx/conf.d/proxy-api.inc;
        include /etc/nginx/conf.d/security-headers.inc;
    }

    # Justificatifs de l'onglet Frontalier : jusqu'à 10 fichiers de 10 Mo par
    # envoi, et un appel au modèle par fichier, plus long qu'un simple calcul.
    # Seule location à dépasser le plafond de 1 Mo fixé plus haut.
    location = /api/frontalier/documents {
        limit_req zone=documents burst=3 nodelay;
        limit_req zone=global burst=40 nodelay;
        client_max_body_size 100m;
        proxy_read_timeout 180s;
        include /etc/nginx/conf.d/proxy-api.inc;
        include /etc/nginx/conf.d/security-headers.inc;
    }

    # Le calcul lui-même : rien n'est écrit, c'est la limite générale qui
    # s'applique. Le comparateur en envoie cinq à chaque clic.
    location = /api/simulations/run {
        include /etc/nginx/conf.d/proxy-api.inc;
        include /etc/nginx/conf.d/security-headers.inc;
    }

    location /api/simulations {
        limit_req zone=ecriture burst=10 nodelay;
        limit_req zone=global burst=40 nodelay;
        include /etc/nginx/conf.d/proxy-api.inc;
        include /etc/nginx/conf.d/security-headers.inc;
    }

    location /api/ {
        include /etc/nginx/conf.d/proxy-api.inc;
        include /etc/nginx/conf.d/security-headers.inc;
    }

    # SPA: any non-API, non-file route falls back to index.html.
    location / {
        try_files $uri $uri/ /index.html;
        include /etc/nginx/conf.d/security-headers.inc;
    }
}
